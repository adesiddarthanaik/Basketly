# MongoDB Database Connection String
MONGO_URI=mongodb://127.0.0.1:27017/quikbuy

# JWT Secret Key
SUPER_SECRET=your_jwt_super_secret_key_here

# Frontend Application Origin for CORS
CLIENT_URL=http://localhost:5173

# Server Port
PORT=5000

# Razorpay Test / Live Credentials
TEST_KEY=rzp_test_your_key_id_here
TEST_SECRET=your_razorpay_secret_here

# Optional: Initial Admin User Setup for createAdmin.js
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=AdminSecurePassword123!
